{
	"name": "@ethereum-indexer/processor-sqlite",
	"version": "0.0.0",
	"description": "An EventProcessor whose derived state lives in the versioned-row state store instead of memory, so indexing a chain produces time-travellable state as a side effect of normal processing.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"license": "MIT",
	"dependencies": {
		"@ethereum-indexer/state-store-sqlite": "workspace:*",
		"ethereum-indexer": "workspace:*",
		"named-logs": "^0.4.1",
		"remote-sql": "^0.0.7"
	},
	"devDependencies": {
		"@libsql/client": "^0.17.3",
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"ethereum-indexer-js-processor": "workspace:*",
		"remote-sql-libsql": "^0.0.7",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "tsc",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
