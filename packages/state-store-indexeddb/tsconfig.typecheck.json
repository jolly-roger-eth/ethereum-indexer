{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": [
			"node"
		],
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"rootDir": "."
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"browser/**/*.ts",
		"playwright.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
