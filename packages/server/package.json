{
	"name": "@etherfold/server",
	"version": "0.0.0",
	"description": "Platform-agnostic indexer-server for etherfold: a Hono app that receives its database and environment by injection, so the same server runs on Node, Cloudflare Workers or anything else.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"license": "MIT",
	"dependencies": {
		"hono": "^4.13.3",
		"named-logs": "^0.4.1",
		"remote-sql": "^0.0.7"
	},
	"devDependencies": {
		"@libsql/client": "^0.17.3",
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"remote-sql-libsql": "^0.0.7",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"sql2ts": "node sql2ts.cjs ./src/schema/sql",
		"build": "pnpm sql2ts && tsc",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
