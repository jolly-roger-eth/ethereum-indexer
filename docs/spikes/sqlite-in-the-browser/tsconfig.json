{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": false,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "browser/**/*.ts", "run/**/*.ts", "vendor/**/*.ts", "playwright.config.ts"]
}
